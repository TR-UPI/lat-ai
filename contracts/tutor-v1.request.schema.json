{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LAT tutor v1 request",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "action": {
      "enum": [
        "explain",
        "hint"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "x-maxUtf16Units": 2000
    },
    "course_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "lesson_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "exercise_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "const": "internal",
      "default": "internal"
    },
    "document_ids": {
      "type": "array",
      "maxItems": 0
    },
    "code_context": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 4000,
          "x-maxUtf16Units": 4000
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "selection": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "revision",
        "selection"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "action",
    "question",
    "course_id",
    "lesson_id"
  ],
  "additionalProperties": false,
  "description": "After shape validation, enforce visible well-formed question, UTF16 lengths sum<=6000, selection start<end<=code.length, no surrogate/CRLF split. Hint exercise_id is required semantically AFTER authorization/policy; missing ID produces422 UNSUPPORTED_TASK, except an applicable policy response. Unsupported mode/documents produce422. Runtime adapter is normative for these semantic checks."
}
